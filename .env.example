# Database
DATABASE_URL=postgres://postchi:postchi@localhost:5432/postchi?sslmode=disable

# Auth
JWT_SECRET=change-me-in-production-use-32-chars-min
JWT_ISSUER=postchi
ENCRYPTION_KEY=postchi-dev-encryption-key-32b!!

# Server
HTTP_PORT=8080
ENVIRONMENT=development
# Comma-separated browser origins (scheme + host + port). Add your LAN IP when testing remotely.
# Example: CORS_ORIGINS=http://localhost:3000,http://192.168.1.10:3000
CORS_ORIGINS=http://localhost:3000

# Public URLs (for remote/self-hosted access)
# PUBLIC_APP_URL: URL teammates use in the browser for the UI
PUBLIC_APP_URL=http://localhost:3000
# NUXT_PUBLIC_API_URL: URL the browser uses to reach the API. Leave empty for same-origin /api (recommended with reverse proxy or dev proxy).
# For split ports without proxy, set to browser-reachable API URL, e.g. http://192.168.1.10:8080
NUXT_PUBLIC_API_URL=
# APP_PUBLIC_URL: base URL for invite and share links
APP_PUBLIC_URL=http://localhost:3000

# SMTP (invite emails; use Mailpit in docker-compose for local dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=postchi@localhost
INVITE_TTL_HOURS=168

# Optional: restrict self-registration to specific email domains (comma-separated).
# Invites are not restricted. Leave empty to allow any email at registration.
REGISTRATION_ALLOWED_EMAIL_DOMAINS=

# Frontend dev proxy target (when NUXT_PUBLIC_API_URL is empty)
NUXT_DEV_API_PROXY=http://localhost:8080

# Limits
REQUEST_TIMEOUT_SECONDS=30
MAX_RESPONSE_BYTES=10485760

# Migrations (local dev; Docker uses file:///migrations)
# AUTO_MIGRATE=true applies pending SQL on API startup (fail-fast). Set false if a
# separate migrate Job/init container runs /app/postchi-migrate before the API.
MIGRATIONS_PATH=file://migrations
AUTO_MIGRATE=true
DB_READY_TIMEOUT=60s
