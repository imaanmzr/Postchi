{
  "info": {
    "name": "Mixed Order Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.example.com" }
  ],
  "item": [
    {
      "name": "Request First",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/first"
      }
    },
    {
      "name": "Folder B",
      "item": [
        {
          "name": "Nested Request",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/nested"
          }
        }
      ]
    },
    {
      "name": "Empty Folder",
      "item": []
    },
    {
      "name": "Request Last",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/last"
      }
    }
  ]
}
